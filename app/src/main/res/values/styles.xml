<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/grid</item>
        <item name="android:colorPrimaryDark">@color/grid</item>
        <item name="android:colorAccent">@color/grid</item>
        <item name="android:statusBarColor">@color/grid</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="CopyButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/btn_soft</item>
        <item name="android:text">@string/copy</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/grid</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
